{
  "series": "我不是戏神",
  "subtitle": "第一卷 · 戏中人",
  "episodes": [
    {
      "id": "ep01",
      "number": 1,
      "title": "戏鬼回家",
      "chapters": [
        1
      ],
      "duration_s": 210,
      "opening_state": {
        "clock": "rainy_night",
        "costume": "red_robe",
        "expectation": null,
        "letter": false
      },
      "closing_state": {
        "clock": "rainy_night",
        "costume": "red_robe",
        "expectation": null,
        "letter": false
      },
      "shots": [
        {
          "id": "title",
          "scene": "title",
          "seconds": 10,
          "source": "ch01",
          "text": "",
          "label": "雨夜 · 寒霜街"
        },
        {
          "id": "lost",
          "scene": "rain_wide",
          "seconds": 12,
          "source": "ch01",
          "text": "大雨封住了整条街。一个穿红戏袍的少年走在雨里，脑中挤满陌生的声音。",
          "emotion": "lost",
          "sfx": "thunder"
        },
        {
          "id": "face",
          "scene": "rain_face",
          "seconds": 10,
          "source": "ch01",
          "speaker": "陈伶",
          "text": "停下来……让我想想。我一定有自己的名字。",
          "emotion": "afraid"
        },
        {
          "id": "fall",
          "scene": "rain_fall",
          "seconds": 10,
          "source": "ch01",
          "text": "凸起的石块绊住赤裸的脚。他跌进泥水，额角的血被雨水带走。",
          "sfx": "fall"
        },
        {
          "id": "name",
          "scene": "rain_face",
          "seconds": 10,
          "source": "ch01",
          "speaker": "陈伶",
          "text": "陈伶。对，我叫陈伶。可这些记忆……究竟属于谁？",
          "emotion": "lost",
          "motif": "陈伶"
        },
        {
          "id": "memory",
          "scene": "memory",
          "seconds": 10,
          "source": "ch01",
          "text": "另一段人生浮上来。二十八岁，京城剧院的实习编导。演出散场，他还在独自安排走位。",
          "label": "记忆碎片 · 前世"
        },
        {
          "id": "quake",
          "scene": "memory_fall",
          "seconds": 10,
          "source": "ch01",
          "text": "地面突然震动。头顶的射灯坠下，那段人生在一瞬间中断。",
          "sfx": "impact"
        },
        {
          "id": "two_memories",
          "scene": "rain_face",
          "seconds": 10,
          "source": "ch01",
          "text": "如今这具少年的身体，也叫陈伶。两份记忆相互撕扯，只有回家的路还清楚。",
          "emotion": "lost"
        },
        {
          "id": "walk",
          "scene": "rain_wide",
          "seconds": 10,
          "source": "ch01",
          "speaker": "陈伶",
          "text": "先回去。弟弟的诊所……这条路，我应该每天都走过。",
          "emotion": "tired"
        },
        {
          "id": "door",
          "scene": "door",
          "seconds": 10,
          "source": "ch01",
          "text": "他摸不到钥匙，却本能地伸向报刊箱底。备用钥匙，就在那里。",
          "sfx": "key"
        },
        {
          "id": "home",
          "scene": "door_open",
          "seconds": 10,
          "source": "ch01",
          "speaker": "陈伶",
          "text": "爸，妈……是我。我回来了。",
          "label": "寒霜街 128 号",
          "sfx": "door"
        },
        {
          "id": "parents",
          "scene": "parents",
          "seconds": 10,
          "source": "ch01",
          "text": "餐桌边的两个人刚哭过。他们望着门口的红衣少年，脸上却没有重逢的喜色。",
          "emotion": "afraid"
        },
        {
          "id": "barefeet",
          "scene": "footprints",
          "seconds": 10,
          "source": "ch01",
          "text": "他低头才发现鞋早已不见。两个泥脚印留在地板上，雨水顺着袖口往下滴。"
        },
        {
          "id": "thirst",
          "scene": "water",
          "seconds": 10,
          "source": "ch01",
          "speaker": "陈伶",
          "text": "我太渴了……有水吗？",
          "emotion": "tired",
          "sfx": "water"
        },
        {
          "id": "barrel",
          "scene": "water_break",
          "seconds": 10,
          "source": "ch01",
          "text": "他抱起水桶痛饮。桶口在牙齿下碎裂，吞水声盖过母亲发抖的询问。",
          "sfx": "crack"
        },
        {
          "id": "echo",
          "scene": "water_echo",
          "seconds": 10,
          "source": "ch01",
          "text": "他的嘴还贴着水桶，回答却从身后传来。那里没有人，声音却清楚得可怕。",
          "sfx": "whisper"
        },
        {
          "id": "lamp",
          "scene": "lamp",
          "seconds": 10,
          "source": "ch01",
          "speaker": "陈伶",
          "text": "路上摔了几次。地板脏了，我明天再擦……现在只想睡。"
        },
        {
          "id": "bed",
          "scene": "bedroom",
          "seconds": 10,
          "source": "ch01",
          "text": "水桶终于空了。他拖着湿透的戏袍走回卧室，倒在床上。门外的两个人仍不敢动。",
          "sfx": "door"
        },
        {
          "id": "silence",
          "scene": "parents",
          "seconds": 10,
          "source": "ch01",
          "speaker": "陈坛",
          "text": "不可能……他怎么能回来？昨晚的事，明明已经做完了。",
          "emotion": "afraid"
        },
        {
          "id": "reveal",
          "scene": "parents_close",
          "seconds": 10,
          "source": "ch01",
          "speaker": "李秀春",
          "text": "如果房里的是阿伶……昨晚死在我们手里的，又是谁？",
          "emotion": "afraid"
        },
        {
          "id": "end",
          "scene": "end",
          "seconds": 8,
          "source": "ch01",
          "text": "",
          "label": "下一集 · 我们在看着你"
        }
      ]
    },
    {
      "id": "ep02",
      "number": 2,
      "title": "我们在看着你",
      "chapters": [
        2,
        3
      ],
      "duration_s": 210,
      "opening_state": {
        "clock": "rainy_night",
        "costume": "red_robe",
        "expectation": null,
        "letter": false
      },
      "closing_state": {
        "clock": "morning",
        "costume": "black_coat",
        "expectation": 30,
        "letter": false
      },
      "shots": [
        {
          "id": "title",
          "scene": "title",
          "seconds": 10,
          "source": "ch02",
          "text": "",
          "label": "同一夜 · 门里门外"
        },
        {
          "id": "secret",
          "scene": "parents",
          "seconds": 9,
          "source": "ch02",
          "text": "陈坛不敢报给执法者。让外人调查，昨夜的秘密也会一并暴露。"
        },
        {
          "id": "departure",
          "scene": "parents_leave",
          "seconds": 9,
          "source": "ch02",
          "text": "两人套上雨衣，决定亲眼检查埋尸的地方。屋里只剩沉睡的陈伶。",
          "sfx": "door"
        },
        {
          "id": "sleep",
          "scene": "bedroom",
          "seconds": 9,
          "source": "ch02",
          "text": "睡梦中，他的意识不断下坠。直到脚下重新出现了坚硬的地板。",
          "emotion": "afraid"
        },
        {
          "id": "stage",
          "scene": "stage",
          "seconds": 10,
          "source": "ch02",
          "text": "聚光灯逐盏打开。旧木地板，黑色帘幕。这里像剧院，却不是他熟悉的那一座。",
          "label": "意识深处 · 剧院",
          "sfx": "spotlight"
        },
        {
          "id": "follow",
          "scene": "stage_walk",
          "seconds": 9,
          "source": "ch02",
          "speaker": "陈伶",
          "text": "有人在控制追光？听得到吗？这里到底是什么地方？",
          "emotion": "afraid"
        },
        {
          "id": "screen",
          "scene": "expectation",
          "seconds": 10,
          "source": "ch02",
          "text": "舞台边缘亮起一块屏幕：观众期待值，百分之二十九。",
          "expectation": 29
        },
        {
          "id": "warning",
          "scene": "expectation",
          "seconds": 10,
          "source": "ch02",
          "text": "另一行字警告他：低于百分之二十，演员的安全将失去保障。",
          "expectation": 29,
          "motif": "低于 20% · 安全不再受保障"
        },
        {
          "id": "audience",
          "scene": "audience",
          "seconds": 10,
          "source": "ch02",
          "text": "灯光越过舞台。木椅上挤满了类人的阴影，只有一双双猩红眼睛能被看清。",
          "sfx": "whisper"
        },
        {
          "id": "pursuit",
          "scene": "stage_run",
          "seconds": 10,
          "source": "ch02",
          "text": "他跑向两侧出口，迎面都是墙。追光紧咬着他，观众的目光也一起移动。",
          "sfx": "steps"
        },
        {
          "id": "thirty",
          "scene": "expectation",
          "seconds": 9,
          "source": "ch02",
          "text": "他的惊慌像一场演出。屏幕上的数值，升到了百分之三十。",
          "expectation": 30
        },
        {
          "id": "curtain",
          "scene": "curtain",
          "seconds": 10,
          "source": "ch02",
          "text": "铃声响起。屏幕催促演出继续，身后庞大的黑帘缓缓打开。",
          "motif": "中场休息结束",
          "sfx": "bell"
        },
        {
          "id": "wake",
          "scene": "bedroom_wake",
          "seconds": 9,
          "source": "ch02",
          "text": "陈伶猛地坐起。雨快停了，父母不在家。他想把那一切当作噩梦。",
          "label": "次日 · 清晨"
        },
        {
          "id": "debris",
          "scene": "water_debris",
          "seconds": 9,
          "source": "ch02",
          "text": "厨房的碎水桶拦住脚步。他不记得昨晚为何会这样，只拿来抹布准备清理。"
        },
        {
          "id": "message",
          "scene": "water_message",
          "seconds": 10,
          "source": "ch02",
          "text": "地上的水自己流动，变成红色。那场梦，在现实里写下了回答。",
          "motif": "我们在看着你",
          "sfx": "whisper"
        },
        {
          "id": "coat",
          "scene": "coat",
          "seconds": 9,
          "source": "ch03",
          "speaker": "陈伶",
          "text": "也许是记忆出了问题。我得去找医生，先把这件事弄清楚。",
          "costume": "black_coat"
        },
        {
          "id": "aurora",
          "scene": "aurora",
          "seconds": 10,
          "source": "ch03",
          "text": "他披上黑棉大衣推门出去。白昼的天空里，蓝色极光像缎带一样流动。",
          "costume": "black_coat",
          "label": "三区 · 寒霜街"
        },
        {
          "id": "grave",
          "scene": "grave",
          "seconds": 10,
          "source": "ch03",
          "text": "与此同时，父母赶到乱葬岗。黄色警戒线后，十多名黑红制服的执法者正在搜索。",
          "costume": "black_coat",
          "label": "同一清晨 · 乱葬岗"
        },
        {
          "id": "inquiry",
          "scene": "grave_inquiry",
          "seconds": 10,
          "source": "ch03",
          "text": "两人谎称祭拜儿子。江勤记下姓名住址：陈坛、李秀春，寒霜街一百二十八号。",
          "costume": "black_coat"
        },
        {
          "id": "han",
          "scene": "han",
          "seconds": 10,
          "source": "ch03",
          "speaker": "韩蒙",
          "text": "冒雨走十几公里来祭拜？有父母的孩子，为什么埋在乱葬岗？跟着他们。",
          "costume": "black_coat"
        },
        {
          "id": "device",
          "scene": "device",
          "seconds": 10,
          "source": "ch03",
          "text": "韩蒙打开灾厄指针。短暂的静止后，指针疯狂横扫，仪器在他手边炸开。",
          "costume": "black_coat",
          "sfx": "device_break"
        },
        {
          "id": "end",
          "scene": "end",
          "seconds": 8,
          "source": "ch03",
          "text": "",
          "label": "下一集 · 陈氏编导法则"
        }
      ]
    },
    {
      "id": "ep03",
      "number": 3,
      "title": "陈氏编导法则",
      "chapters": [
        4,
        5,
        6
      ],
      "duration_s": 240,
      "opening_state": {
        "clock": "morning",
        "costume": "black_coat",
        "expectation": 30,
        "letter": false
      },
      "closing_state": {
        "clock": "morning",
        "costume": "black_coat",
        "expectation": 32,
        "letter": true,
        "expectation_after_32": "increments_only"
      },
      "shots": [
        {
          "id": "title",
          "scene": "title",
          "seconds": 12,
          "source": "ch04",
          "text": "",
          "label": "同一清晨 · 寒霜街"
        },
        {
          "id": "salt_cart",
          "scene": "salt",
          "seconds": 10,
          "source": "ch04",
          "text": "去诊所的路上，陈伶遇见赵乙。小六蹬着三轮车，赵乙坐在后面往路面撒盐。",
          "costume": "black_coat"
        },
        {
          "id": "salt_throw",
          "scene": "salt_throw",
          "seconds": 10,
          "source": "ch04",
          "text": "赵乙挖苦他的执法者考试，又故意把盐扬到他身上。陈伶压住火气，没有追上去。",
          "costume": "black_coat",
          "sfx": "salt"
        },
        {
          "id": "twenty_seven",
          "scene": "salt_message",
          "seconds": 10,
          "source": "ch04",
          "text": "冰霜融化，盐粒短暂排成数字。观众期待值，百分之二十七。",
          "costume": "black_coat",
          "expectation": 27
        },
        {
          "id": "clinic",
          "scene": "clinic",
          "seconds": 10,
          "source": "ch04",
          "text": "林医生认识他。陈宴已转去二区住院，这次来求助的却是哥哥自己。",
          "costume": "black_coat",
          "label": "寒霜街 · 诊所"
        },
        {
          "id": "symptoms",
          "scene": "clinic_close",
          "seconds": 10,
          "source": "ch04",
          "speaker": "陈伶",
          "text": "梦醒以后，观众还在。我像被困在舞台上，连身边的东西也被它们改变。",
          "costume": "black_coat",
          "emotion": "afraid"
        },
        {
          "id": "tea",
          "scene": "tea",
          "seconds": 10,
          "source": "ch04",
          "text": "林医生刚要喝茶，便猛地停下。那杯普洱不知何时，已经变成了血液。",
          "costume": "black_coat",
          "sfx": "cup"
        },
        {
          "id": "real",
          "scene": "clinic_close",
          "seconds": 10,
          "source": "ch04",
          "speaker": "林医生",
          "text": "这已经超出幻觉的范围。昨晚，你有没有卷进灰界交汇？",
          "costume": "black_coat"
        },
        {
          "id": "gray",
          "scene": "gray",
          "seconds": 10,
          "source": "ch05",
          "text": "林医生解释：赤色流星之后，一个灰色世界开始与现实重叠，原本的秩序逐渐失效。",
          "costume": "black_coat",
          "label": "林医生的讲述 · 灰界"
        },
        {
          "id": "paper",
          "scene": "paper",
          "seconds": 10,
          "source": "ch05",
          "text": "他用纸和水演示交汇。水渍一点点浸透纸面，就像灰界不断侵入人类的世界。",
          "costume": "black_coat"
        },
        {
          "id": "domains",
          "scene": "domains",
          "seconds": 10,
          "source": "ch05",
          "text": "人类只剩九座域延续火种。灰界的怪物被称作灾厄；遭遇它们，也可能留下精神创伤。",
          "costume": "black_coat",
          "motif": "九座域 · 人类的火种"
        },
        {
          "id": "letter",
          "scene": "letter",
          "seconds": 10,
          "source": "ch05",
          "speaker": "林医生",
          "text": "我治不了这种情况。带着这封信去极光城，也许有人能帮你。他是一位真正的医生。",
          "costume": "black_coat",
          "letter": true,
          "sfx": "paper"
        },
        {
          "id": "numbers",
          "scene": "thinking",
          "seconds": 10,
          "source": "ch05",
          "text": "离开诊所，陈伶把数字串起来。逃跑时上升，平静时下降，茶水的恶作剧又让它回到二十九。",
          "costume": "black_coat",
          "expectation": 29
        },
        {
          "id": "idea",
          "scene": "thinking_close",
          "seconds": 10,
          "source": "ch05",
          "speaker": "陈伶",
          "text": "它们看的，是情节。如果我主动设计一场戏，能不能把危险往后推？",
          "costume": "black_coat",
          "emotion": "thinking"
        },
        {
          "id": "breakfast",
          "scene": "breakfast",
          "seconds": 10,
          "source": "ch05",
          "text": "赵叔的早餐铺冒着热气。他请陈伶吃豆浆油条，叹起儿子赵乙的学业。",
          "costume": "black_coat",
          "label": "寒霜街 · 赵家早餐铺"
        },
        {
          "id": "misunderstanding",
          "scene": "breakfast_close",
          "seconds": 10,
          "source": "ch05",
          "text": "陈伶故意吞吞吐吐，把赵乙和骑车少年的来往，说成了偷偷恋爱。误会是他编出来的。",
          "costume": "black_coat"
        },
        {
          "id": "thirty_two",
          "scene": "soy",
          "seconds": 10,
          "source": "ch06",
          "text": "豆浆表面显出回应：增加三点，当前百分之三十二。他第一次验证了自己的猜测。",
          "costume": "black_coat",
          "expectation": 32
        },
        {
          "id": "rule",
          "scene": "rule",
          "seconds": 10,
          "source": "ch06",
          "text": "前世归纳的编导法则浮上心头：情节需要冲突；没有冲突，就用误会把它推动起来。",
          "costume": "black_coat",
          "motif": "第九条 · 矛盾推动情节"
        },
        {
          "id": "coins",
          "scene": "coins",
          "seconds": 10,
          "source": "ch06",
          "text": "三轮车回来了。二十枚报酬里，赵乙只给小六两枚，还威胁他明天继续骑车。",
          "costume": "black_coat"
        },
        {
          "id": "chase",
          "scene": "chase",
          "seconds": 10,
          "source": "ch06",
          "text": "赵叔带着误会追出来，赵乙越解释越狼狈。街坊聚拢，观众期待值开始接连上涨。",
          "costume": "black_coat",
          "increment": 1,
          "sfx": "steps"
        },
        {
          "id": "recruit",
          "scene": "recruit",
          "seconds": 10,
          "source": "ch06",
          "speaker": "陈伶",
          "text": "小六，你想让他以后不敢再欺负你吗？那就听我说，下一步这样做。",
          "costume": "black_coat",
          "emotion": "thinking"
        },
        {
          "id": "intervene",
          "scene": "intervene",
          "seconds": 10,
          "source": "ch06",
          "text": "小六冲进人群，抱住赵乙，替他挡在赵叔面前。赵乙的解释突然失去了可信度。",
          "costume": "black_coat",
          "increment": 2
        },
        {
          "id": "director",
          "scene": "director",
